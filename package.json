{
  "name": "advanced-trading-bot-v4",
  "version": "4.0.0",
  "type": "module",
  "description": "🚀 Super Advanced AI-Powered Binance Futures Trading Bot V4 - ML, Real-time Flows, Scalping Strategy",
  "main": "src/enhanced-server.ts",
  "scripts": {
    "dev": "concurrently \"tsx watch src/enhanced-server.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/enhanced-server.ts",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "jest",
    "docker:build": "docker build -t trading-bot:latest .",
    "docker:run": "docker run -p 3000:3000 trading-bot:latest",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "db:migrate": "npm run build && node dist/migrations/index.js",
    "db:seed": "node dist/seeds/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ccxt": "^4.0.0",
    "ws": "^8.13.0",
    "technicalindicators": "^3.1.0",
    "vite": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.263.1",
    "recharts": "^2.8.0",
    "tailwindcss": "^3.3.5",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "tsx": "^3.13.0",
    "concurrently": "^8.2.0"
  }
}
